# ===== VALDEZ BOT =====
# Crie seu bot em: https://discord.com/developers/applications

# Bot token (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=

# ID do servidor (click direito no servidor > Copy Server ID)
GUILD_ID=

# ID do canal de voz padrão (click direito no canal > Copy Channel ID)
VOICE_CHANNEL_ID=

# ID do canal de texto para logs/comandos e modal de música (opcional)
LOG_CHANNEL_ID=

# Client ID do bot (Discord Developer Portal > General Information > Application ID)
CLIENT_ID=

# ===== SPOTIFY (opcional, necessário para playlists/álbuns) =====
# Como obter: rode `npx play-dl auth` numa máquina local seguindo o wizard.
# Sem isso o bot só toca tracks individuais do Spotify (e tudo do YouTube).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_MARKET=BR
