# ===== VALDEZ BOT =====
# Crie seu bot em: https://discord.com/developers/applications

# Bot token (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=

# ID do servidor (click direito no servidor > Copy Server ID)
GUILD_ID=

# ID do canal de voz padrão (click direito no canal > Copy Channel ID)
VOICE_CHANNEL_ID=

# ID do canal de texto para logs/comandos (opcional)
LOG_CHANNEL_ID=

# Client ID do bot (Discord Developer Portal > General Information > Application ID)
CLIENT_ID=
